{
  "name": "tachyon-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:minilm": "MINILM=1 vitest run test/semanticMinilm.test.ts",
    "typecheck": "tsc --noEmit",
    "prefetch": "node dist/src/prefetch.js",
    "bench:load": "tsx bench/loadtest.ts",
    "bench:cache": "tsx bench/cacheBench.ts",
    "bench:breaker": "tsx bench/breakerDemo.ts",
    "bench:sweep": "tsx bench/thresholdSweep.ts",
    "bench:staleness": "tsx bench/stalenessSim.ts"
  },
  "dependencies": {
    "@fastify/cors": "10.1.0",
    "@huggingface/transformers": "3.8.1",
    "fastify": "5.12.5",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
